# Copy this file to .env and fill in the real values.
# .env is ignored by Git. Never commit it, and never put real values in this file.

DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=course_registration

PORT=3000

# Signs login tokens. Use a long random value, for example the output of:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-long-random-secret
